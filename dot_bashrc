# Interactive Bash configuration.
[[ $- != *i* ]] && return

# Keep the environment available even for interactive non-login shells.
if [[ -r "$HOME/.config/shell/env.sh" ]]; then
  . "$HOME/.config/shell/env.sh"
fi

# History
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s histappend checkwinsize

# Prompt
if [[ -z "${debian_chroot:-}" && -r /etc/debian_chroot ]]; then
  debian_chroot=$(< /etc/debian_chroot)
fi

case "${TERM:-}" in
  *-256color|xterm-color) _bash_color_prompt=true ;;
  *) _bash_color_prompt=false ;;
esac

if $_bash_color_prompt; then
  PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
  PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset _bash_color_prompt

case "${TERM:-}" in
  xterm*|rxvt*) PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1" ;;
esac

# LS_COLORS
if command -v dircolors >/dev/null 2>&1; then
  if [[ -r "$HOME/.dircolors" ]]; then
    eval "$(dircolors -b "$HOME/.dircolors" 2>/dev/null)"
  else
    eval "$(dircolors -b 2>/dev/null)"
  fi
fi

# Bash completion
if ! shopt -oq posix; then
  if [[ -r /usr/share/bash-completion/bash_completion ]]; then
    . /usr/share/bash-completion/bash_completion
  elif [[ -r /etc/bash_completion ]]; then
    . /etc/bash_completion
  fi
fi

# Bash-specific modules
for _bash_module in aliases functions integrations; do
  if [[ -r "$HOME/.config/bash/${_bash_module}.sh" ]]; then
    . "$HOME/.config/bash/${_bash_module}.sh"
  fi
done
unset _bash_module

# NVM manages shell functions and therefore belongs in interactive Bash.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  . "$NVM_DIR/nvm.sh"
fi
if [[ -s "$NVM_DIR/bash_completion" ]]; then
  . "$NVM_DIR/bash_completion"
fi
