# General environment for login sessions.
if [ -r "$HOME/.config/shell/env.sh" ]; then
  . "$HOME/.config/shell/env.sh"
fi

if [ -r "$HOME/.config/shell/login.sh" ]; then
  . "$HOME/.config/shell/login.sh"
fi

# Bash login shells also load the interactive Bash configuration.
if [ -n "${BASH_VERSION:-}" ] && [ -r "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi

# Start X automatically on the first virtual console when it is available.
if [ -z "${DISPLAY:-}" ] && command -v tty >/dev/null 2>&1; then
  _profile_tty=$(tty 2>/dev/null) || _profile_tty=
  if [ "$_profile_tty" = "/dev/tty1" ] && command -v startx >/dev/null 2>&1; then
    startx
  fi
  unset _profile_tty
fi
