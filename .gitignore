# Editor and temporary files
*~
*.swp
*.swo
*.tmp

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local caches
.cache/

# Unmanaged machine-local files, including chezmoi source-name variants.
**/*local.sh
**/*local.sh.tmpl
**/*local.zsh
**/*local.zsh.tmpl
.gitconfig.local
*dot_gitconfig.local
*dot_gitconfig.local.tmpl
