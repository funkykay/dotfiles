#!/usr/bin/env bash

set -u

shell_name=${SHELL:-}
shell_name=${shell_name##*/}
if [[ "$shell_name" == zsh ]]; then
  current_shell="zsh (from SHELL)"
  shell_config=("$HOME/.zshenv" "$HOME/.zprofile" "$HOME/.zshrc" \
    "$HOME/.config/zsh/integrations.zsh" "$HOME/.config/zsh/local.zsh")
elif [[ "$shell_name" == bash ]]; then
  current_shell="bash (from SHELL)"
  shell_config=("$HOME/.bash_profile" "$HOME/.profile" "$HOME/.bashrc" "$HOME/.config/bash/integrations.sh" \
    "$HOME/.config/bash/local.sh")
else
  current_shell="${SHELL:-unknown} (shell type not identified)"
  shell_config=("$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshenv" "$HOME/.zprofile" "$HOME/.zshrc")
fi

printf 'Shell: %s\n' "$current_shell"
printf 'Login shell: %s\n' "${SHELL:-unknown}"
printf 'Working directory: %s\n' "$PWD"

printf '\nConfiguration files:\n'
for config in "$HOME/.config/shell/env.sh" "$HOME/.config/shell/local.sh" \
  "$HOME/.config/shell/login.sh" "$HOME/.config/shell/interactive.sh" \
  "$HOME/.config/shell/aliases.sh" "$HOME/.config/shell/functions.sh" "${shell_config[@]}"; do
  [[ -n "$config" ]] || continue
  if [[ -r "$config" ]]; then
    printf '  readable  %s\n' "$config"
  else
    printf '  missing   %s\n' "$config"
  fi
done

printf '\nSelected environment:\n'
for name in HOME SHELL PATH XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME \
  ASDF_DATA_DIR NVM_DIR GOPATH; do
  if [[ ${!name+x} ]]; then
    printf '  %s=%s\n' "$name" "${!name}"
  else
    printf '  %s=<unset>\n' "$name"
  fi
done

printf '\nPATH entries:\n'
path_index=0
IFS=: read -r -a path_entries <<< "${PATH:-}"
for entry in "${path_entries[@]}"; do
  ((path_index += 1))
  [[ -n "$entry" ]] || entry='.'
  if [[ -d "$entry" ]]; then
    printf '  %2d  %s\n' "$path_index" "$entry"
  else
    printf '  %2d  %s (missing directory)\n' "$path_index" "$entry"
  fi
done
