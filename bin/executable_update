#!/usr/bin/env bash
set -e

if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != --upgrade ]]; }; then
  printf 'usage: update [--upgrade]\nWithout arguments, simulate an apt-get upgrade using the current package indexes.\n' >&2
  exit 2
fi
if ! command -v apt-get >/dev/null 2>&1; then
  printf 'update: apt-get is required; this utility is for Debian/Ubuntu systems\n' >&2
  exit 127
fi

if (( $# == 0 )); then
  exec apt-get --simulate --no-remove upgrade
fi
if [[ ! -t 0 || ! -t 1 ]]; then
  printf 'update: --upgrade requires an interactive terminal\n' >&2
  exit 1
fi

privilege=()
if (( EUID != 0 )); then
  privilege=(sudo --)
fi
"${privilege[@]}" apt-get -o APT::Update::Error-Mode=any update
"${privilege[@]}" apt-get -o quiet=0 --no-remove \
  -o APT::Get::Assume-Yes=false -o APT::Get::Assume-No=false upgrade

