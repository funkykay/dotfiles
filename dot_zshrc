# Interactive Zsh configuration.
[[ -o interactive ]] || return

# Common environment, including optional machine-local variables and paths.
if [[ -r "$HOME/.config/shell/env.sh" ]]; then
  source "$HOME/.config/shell/env.sh"
fi
typeset -U path PATH

# Oh My Zsh is optional; load only plugins installed on this machine.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME=""
plugins=()
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  for _zsh_plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    if [[ -r "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$_zsh_plugin/$_zsh_plugin.plugin.zsh" ||
          -r "$ZSH/plugins/$_zsh_plugin/$_zsh_plugin.plugin.zsh" ]]; then
      plugins+=("$_zsh_plugin")
    fi
  done
  unset _zsh_plugin
  source "$ZSH/oh-my-zsh.sh"
fi

# Completion also works when Oh My Zsh is not installed.
if (( ! $+functions[compdef] )); then
  autoload -Uz compinit
  compinit
fi

HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=1000
SAVEHIST=2000
setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
PROMPT='%n@%m %~ %# '

if [[ -r "$HOME/.config/shell/interactive.sh" ]]; then
  source "$HOME/.config/shell/interactive.sh"
fi

# Shell-specific local overrides; common variables belong in shell/local.sh.
if [[ -r "$HOME/.config/zsh/local.zsh" ]]; then
  source "$HOME/.config/zsh/local.zsh"
fi
